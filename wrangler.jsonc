// Cloudflare Workers static-assets deploy (Cloudflare's build runs `npm run build`, then `npx wrangler deploy`).
{
  "name": "harsh-life-portfolio",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "harshsonavane.com", "custom_domain": true },
    { "pattern": "www.harshsonavane.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
